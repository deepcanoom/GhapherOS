{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deepcanoom/GhapherOS/schemas/project.schema.json",
  "title": "Proyecto GhapherOS",
  "description": "Modelo de un proyecto del centro de comando. Lo genera la extracción y lo edita la capa de control.",
  "type": "object",
  "required": ["project", "levels", "nodes", "flows", "scenarios"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"},
    "level": {"type": "string", "enum": ["confirmado", "reportado", "analisis", "hipotesis"]},
    "source": {
      "type": "object",
      "required": ["archivo", "nivel"],
      "additionalProperties": false,
      "properties": {
        "archivo": {"type": "string"},
        "pagina": {"type": "string"},
        "texto": {"type": "string"},
        "nivel": {"$ref": "#/$defs/level"}
      }
    },
    "color": {"type": "string", "enum": ["amber", "red", "green", "cyan", "slate"]},
    "state": {"type": "string", "enum": ["normal", "amber", "red", "green", "retired", "hidden", "ghost"]}
  },
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "client": {"type": "string"},
        "classification": {"type": "string"},
        "description": {"type": "string"},
        "estado": {"type": "string", "enum": ["borrador", "aprobado"], "default": "borrador"}
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "y", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "y": {"type": "number"},
          "name": {"type": "string"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string"},
          "group": {"type": "string", "description": "Módulo al que pertenece el nodo"},
          "level": {"$ref": "#/$defs/id"},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "z": {"type": "number"},
          "w": {"type": "number", "minimum": 0.5},
          "h": {"type": "number", "minimum": 0.3},
          "d": {"type": "number", "minimum": 0.5},
          "tagDy": {"type": "number"},
          "sub": {"type": "object", "additionalProperties": {"type": "string"}},
          "card": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {"type": "string"},
              "es": {"type": "string"},
              "hoy": {"type": "string"},
              "mejora": {"type": "string"},
              "nivel": {"$ref": "#/$defs/level"},
              "fuentes": {"type": "array", "items": {"$ref": "#/$defs/source"}}
            }
          },
          "fuentes": {"type": "array", "items": {"$ref": "#/$defs/source"}}
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "color", "scenes"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}},
          "lift": {"type": "number"},
          "color": {"$ref": "#/$defs/color"},
          "count": {"type": "integer", "minimum": 0, "maximum": 12},
          "speed": {"type": "number", "minimum": 0},
          "pingpong": {"type": "boolean"},
          "dim": {"type": "boolean"},
          "group": {"type": "string"},
          "scenes": {"type": "array", "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string"},
          "tag": {"type": "string"},
          "brief": {"type": "string"},
          "color": {"type": "string"},
          "estado": {"type": "string", "enum": ["borrador", "aprobado"], "default": "borrador"},
          "cam": {
            "type": "object",
            "required": ["pos", "target"],
            "additionalProperties": false,
            "properties": {
              "pos": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "target": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
            }
          },
          "states": {"type": "object", "additionalProperties": {"$ref": "#/$defs/state"}},
          "kpis": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": {"type": "string"},
                "value": {"type": "string"},
                "sub": {"type": "string"},
                "color": {"type": "string"},
                "fuentes": {"type": "array", "items": {"$ref": "#/$defs/source"}}
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "rows"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": {"type": "string"},
                "value": {"type": "number"},
                "text": {"type": "string"},
                "scene": {"$ref": "#/$defs/id"},
                "color": {"type": "string"},
                "nivel": {"$ref": "#/$defs/level"},
                "fuentes": {"type": "array", "items": {"$ref": "#/$defs/source"}}
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "description": "Condiciones simples. La primera versión solo compara campos numéricos y listas de escenarios.",
      "items": {
        "type": "object",
        "required": ["si", "entonces"],
        "additionalProperties": false,
        "properties": {
          "si": {
            "type": "object",
            "description": "Condición. Ejemplo: {\"escena\": \"fase\"} o {\"nivel_minimo\": \"reportado\"}.",
            "additionalProperties": false,
            "properties": {
              "escena": {"$ref": "#/$defs/id"},
              "nivel_minimo": {"$ref": "#/$defs/level"}
            }
          },
          "entonces": {
            "type": "object",
            "description": "Acción: ocultar, resaltar o cambiar el estado de un nodo o flujo.",
            "additionalProperties": false,
            "properties": {
              "ocultar": {"type": "array", "items": {"$ref": "#/$defs/id"}},
              "estado": {"type": "object", "additionalProperties": {"$ref": "#/$defs/state"}}
            }
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["diagrama", "informe", "datos", "otro"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
